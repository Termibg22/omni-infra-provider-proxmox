              {
                "minimum": 0
              }
            ]
          },
          "mtu": {
            "type": [
              "integer",
              "null"
            ],
            "title": "MTU",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 576,
                    "maximum": 65520
                  }
                ]
              }
            ]
          },
          "dhcp4": {
            "type": "boolean",
            "title": "DHCPv4"
          },
          "ip_pool": {
            "type": "string",
            "title": "Static IP Pool"
          },
          "addresses": {
            "type": "array",
            "title": "Static IP Addresses (CIDR)",
            "items": {
              "type": "string"
            }
          },
          "gateway4": {
            "type": "string",
            "title": "IPv4 Gateway"
          },
          "dhcp6": {
            "type": "boolean",
            "title": "DHCPv6",
            "default": false
          },
          "gateway6": {
            "type": "string",
            "title": "IPv6 Gateway"
          },
          "nameservers": {
            "type": "array",
            "title": "DNS Servers",
            "items": {
              "type": "string"
            }
          },
          "search_domains": {
            "type": "array",
            "title": "DNS Search Domains",
            "items": {
              "type": "string"
            }
          },
          "routes": {
            "type": "array",
            "title": "Static Routes",
            "items": {
              "type": "object",
              "title": "Route",
