{
  "type": "object",
  "title": "Proxmox VM Configuration",
  "properties": {
    "node_group": {
      "type": "string",
      "title": "Node Group",
      "default": "",
      "description": "Limit placement to a group of Proxmox nodes. Leave empty to use all current nodes. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "node": {
      "type": "string",
      "title": "Target Node",
      "default": "",
      "description": "Pin this VM to a Proxmox node. Leave empty to use the placement strategy. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "pool": {
      "type": "string",
      "title": "Resource Pool",
      "default": "",
      "description": "Proxmox resource pool. Leave empty to use the Omni MachineRequestSet ID. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "cores": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Cores",
      "default": 2,
      "description": "CPU cores per socket. Omitted, blank or 0 uses 2. Existing saved values are shown directly.",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1
            }
          ]
        }
      ]
    },
    "memory": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Memory",
      "default": 4096,
      "description": "RAM in MiB. Omitted, blank or 0 uses 4096. Existing saved values are shown directly.",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 2048
            }
          ]
        }
      ]
    },
    "_section_boot_disk": {
      "type": "object",
      "title": "Boot Disk",
      "readOnly": true,
      "properties": {}
    },
    "disk_size": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Primary boot disk size in GiB. Empty or 0 uses 20.",
      "title": "Size",
      "default": 20,
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 5
            }
          ]
        }
      ]
    },
    "storage": {
      "type": "string",
      "title": "Storage",
      "default": "",
      "description": "Destination for the boot disk. Leave empty to select available VM disk storage automatically, or retain a previously saved storage rule. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "disk_ssd": {
      "type": "boolean",
      "description": "Enable SSD emulation (ssd=1) for better performance on SSD/NVMe storage",
      "title": "SSD Emulation"
    },
    "disk_discard": {
      "type": "boolean",
      "description": "Enable TRIM/discard support for thin-provisioned storage",
      "title": "Discard (TRIM)"
    },
    "disk_iothread": {
      "type": "boolean",
      "description": "Enable dedicated IO thread for better disk performance",
      "title": "IO Thread"
    },
    "disk_cache": {
      "type": "string",
      "description": "Disk cache mode. Leave empty to use Proxmox's default. Select the empty first row to clear this selection.",
      "title": "Cache",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "none",
          "title": "none"
        },
        {
          "const": "writethrough",
          "title": "writethrough"
        },
        {
          "const": "writeback",
          "title": "writeback"
        },
        {
          "const": "directsync",
          "title": "directsync"
        },
        {
          "const": "unsafe",
          "title": "unsafe"
        }
      ]
    },
    "disk_aio": {
      "type": "string",
      "description": "Async IO mode. Leave empty to use Proxmox's default. Select the empty first row to clear this selection.",
      "title": "Async IO",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "native",
          "title": "native"
        },
        {
          "const": "threads",
          "title": "threads"
        },
        {
          "const": "io_uring",
          "title": "io_uring"
        }
      ]
    },
    "_section_primary_nic": {
      "type": "object",
      "title": "Primary NIC",
      "readOnly": true,
      "properties": {}
    },
    "network_bridge": {
      "type": "string",
      "description": "Bridge for the primary VirtIO NIC. Leave empty to use vmbr0. Select the empty first row to clear this selection.",
      "title": "Bridge",
      "default": "",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "vlan": {
      "type": [
        "integer",
        "null"
      ],
      "description": "VLAN tag for primary NIC, set to 0 for none",
      "title": "VLAN Tag",
      "allOf": [
        {
          "minimum": 0
        }
      ]
    },
    "network_firewall": {
      "type": "boolean",
      "description": "Enable per-VM firewall (fwbr) on primary NIC. Defaults to true. Set false when L2-broadcast services need traffic to bypass fwbr.",
      "title": "Firewall"
    },
    "_section_extra_devices": {
      "type": "object",
      "title": "Additional Devices",
      "readOnly": true,
      "properties": {}
    },
    "additional_disks": {
      "type": "array",
      "description": "Extra data disks appended after the boot disk. Leave empty for a single disk.",
      "items": {
        "type": "object",
        "properties": {
          "disk_size": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Additional disk size in GiB. New disks start at 20. Omitted, blank or 0 also uses 20.",
            "default": 20,
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1
                  }
                ]
              }
            ],
            "title": "Size"
          },
          "disk_ssd": {
            "type": "boolean",
            "description": "Enable SSD emulation for this disk"
          },
          "disk_discard": {
            "type": "boolean",
            "description": "Enable TRIM/discard support for this disk"
          },
          "disk_iothread": {
            "type": "boolean",
            "description": "Enable dedicated IO thread for this disk"
          },
          "disk_cache": {
            "type": "string",
            "description": "Disk cache mode for this disk. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "none",
                "title": "none"
              },
              {
                "const": "writethrough",
                "title": "writethrough"
              },
              {
                "const": "writeback",
                "title": "writeback"
              },
              {
                "const": "directsync",
                "title": "directsync"
              },
              {
                "const": "unsafe",
                "title": "unsafe"
              }
            ]
          },
          "disk_aio": {
            "type": "string",
            "description": "Async IO mode for this disk. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "native",
                "title": "native"
              },
              {
                "const": "threads",
                "title": "threads"
              },
              {
                "const": "io_uring",
                "title": "io_uring"
              }
            ]
          },
          "storage": {
            "type": "string",
            "title": "Storage",
            "default": "",
            "description": "Destination for this disk. Leave empty to inherit the boot disk storage selection. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              }
            ]
          }
        }
      },
      "title": "Additional Disks"
    },
    "additional_nics": {
      "type": "array",
      "description": "Extra network adapters appended after the primary NIC. Leave empty for one adapter.",
      "items": {
        "type": "object",
        "properties": {
          "bridge": {
            "type": "string",
            "description": "Network bridge (e.g., vmbr1)"
          },
          "vlan": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Optional VLAN tag",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "firewall": {
            "type": "boolean",
            "description": "Enable Proxmox firewall for this NIC"
          },
          "addresses": {
            "type": "array",
            "title": "Static IP Addresses (CIDR)",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "gateway4": {
            "type": "string",
            "title": "IPv4 Gateway"
          },
          "ip_pool": {
            "type": "string",
            "title": "Static IP Pool (Auto-Assign)",
            "description": "CIDR range (e.g. '192.168.1.100-192.168.1.150/24') to auto-assign unique IPs per VM."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "virtio",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "virtio",
                "title": "virtio"
              },
              {
                "const": "e1000",
                "title": "e1000"
              },
              {
                "const": "e1000e",
                "title": "e1000e"
              },
              {
                "const": "vmxnet3",
                "title": "vmxnet3"
              },
              {
                "const": "rtl8139",
                "title": "rtl8139"
              }
            ],
            "description": "Select the empty first row to clear this selection."
          },
          "mtu": {
            "type": [
              "integer",
              "null"
            ],
            "title": "MTU",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1,
                    "maximum": 65520
                  }
                ]
              }
            ]
          },
          "queues": {
            "type": [
              "integer",
              "null"
            ],
            "title": "Multiqueue",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1,
                    "maximum": 64
                  }
                ]
              }
            ]
          },
          "rate_limit": {
            "type": [
              "number",
              "null"
            ],
            "title": "Rate Limit (MB/s)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          }
        },
        "required": [
          "bridge"
        ]
      },
      "title": "Additional NICs"
    },
    "_section_compute": {
      "type": "object",
      "title": "Advanced CPU and Memory",
      "readOnly": true,
      "properties": {}
    },
    "sockets": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Sockets",
      "default": 1,
      "description": "Number of CPU sockets",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1
            }
          ]
        }
      ]
    },
    "cpu_type": {
      "type": "string",
      "title": "CPU Type",
      "default": "x86-64-v2-AES",
      "description": "QEMU CPU model ('host' for max performance/GPU, 'x86-64-v2-AES' for live migration). Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "x86-64-v2-AES",
          "title": "x86-64-v2-AES"
        },
        {
          "const": "x86-64-v3",
          "title": "x86-64-v3"
        },
        {
          "const": "x86-64-v4",
          "title": "x86-64-v4"
        },
        {
          "const": "host",
          "title": "host"
        },
        {
          "const": "max",
          "title": "max"
        },
        {
          "const": "kvm64",
          "title": "kvm64"
        },
        {
          "const": "qemu64",
          "title": "qemu64"
        }
      ]
    },
    "balloon": {
      "type": "boolean",
      "title": "Ballooning Device",
      "default": true,
      "description": "Enable memory ballooning (disable for GPU passthrough or hugepages)."
    },
    "numa": {
      "type": "boolean",
      "title": "Enable NUMA",
      "default": false,
      "description": "Enable NUMA topology."
    },
    "hugepages": {
      "type": "string",
      "title": "Hugepages",
      "default": "",
      "description": "Hugepage size. Leave empty to use normal memory pages. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "any",
          "title": "any"
        },
        {
          "const": "2MB",
          "title": "2MB"
        },
        {
          "const": "1GB",
          "title": "1GB"
        }
      ]
    },
    "cpu_flags": {
      "type": "string",
      "title": "CPU Flags",
      "description": "Optional semicolon-separated CPU flags (e.g. '+aes;+avx2;+pdpe1gb')."
    },
    "cpu_limit": {
      "type": [
        "number",
        "null"
      ],
      "title": "CPU Limit",
      "description": "Optional max CPU cores limit (null or 0 for unlimited).",
      "allOf": [
        {
          "minimum": 0
        }
      ]
    },
    "cpu_units": {
      "type": [
        "integer",
        "null"
      ],
      "title": "CPU Units",
      "description": "Optional relative CPU scheduler weight.",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1,
              "maximum": 262144
            }
          ]
        }
      ]
    },
    "_section_placement": {
      "type": "object",
      "title": "Placement and Metadata",
      "readOnly": true,
      "properties": {}
    },
    "placement_strategy": {
      "type": "string",
      "title": "Placement Strategy",
      "default": "spread",
      "description": "Auto-placement strategy when Target Node is empty. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "spread",
          "title": "spread"
        },
        {
          "const": "fewer-vms",
          "title": "fewer-vms"
        },
        {
          "const": "round-robin",
          "title": "round-robin"
        },
        {
          "const": "binpack",
          "title": "binpack"
        }
      ]
    },
    "auto_create_pool": {
      "type": "boolean",
      "title": "Auto-Create Resource Pool",
      "default": true,
      "description": "Automatically create the specified Proxmox resource pool if it does not exist."
    },
    "tags": {
      "type": "array",
      "title": "VM Tags",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Proxmox VM tags"
    },
    "description": {
      "type": "string",
      "title": "Notes / Description",
      "description": "Optional notes shown in the Proxmox VM Summary."
    },
    "onboot": {
      "type": "boolean",
      "title": "Start at Boot",
      "default": true,
      "description": "Automatically start the VM when the Proxmox host boots."
    },
    "protection": {
      "type": "boolean",
      "title": "Protection",
      "default": false,
      "description": "Prevent accidental manual VM deletion in Proxmox."
    },
    "min_vmid": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Minimum VMID",
      "description": "Optional lower bound for Proxmox VMID allocation (e.g. 5000).",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 100,
              "maximum": 999999999
            }
          ]
        }
      ]
    },
    "max_vmid": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Maximum VMID",
      "description": "Optional upper bound for Proxmox VMID allocation (e.g. 5999).",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 100,
              "maximum": 999999999
            }
          ]
        }
      ]
    },
    "_section_provisioning": {
      "type": "object",
      "title": "Guest Provisioning",
      "readOnly": true,
      "properties": {}
    },
    "provisioning_mode": {
      "type": "string",
      "title": "Provisioning Mode",
      "default": "iso",
      "description": "'iso' boots from a Talos Image Factory ISO; 'clone' requires a VM Template. Selecting 'iso' or clearing this selector ignores saved clone options without deleting them. Legacy YAML with a template and no provisioning_mode still clones.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "iso",
          "title": "iso"
        },
        {
          "const": "clone",
          "title": "clone"
        }
      ]
    },
    "iso_storage": {
      "type": "string",
      "title": "ISO Storage",
      "default": "",
      "description": "ISO-capable storage for Talos ISO and Cloud-Init images (empty selects an available ISO storage). Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "template_vmid": {
      "type": "string",
      "title": "VM Template (Clone Mode)",
      "default": "",
      "description": "Required in clone mode. Ignored when Provisioning Mode is explicitly 'iso' or cleared. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "full_clone": {
      "type": "boolean",
      "title": "Full Clone",
      "default": true,
      "description": "Clone mode only. Enabled or omitted: copy disks to the selected storage. Disabled: linked clone using the template's disk storage; leave boot storage blank or select the same storage."
    },
    "architecture": {
      "type": "string",
      "title": "Architecture",
      "default": "amd64",
      "description": "Target CPU architecture for the Talos installation media. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "amd64",
          "title": "amd64"
        },
        {
          "const": "arm64",
          "title": "arm64"
        }
      ]
    },
    "talos_extensions": {
      "type": "array",
      "title": "Talos System Extensions",
      "description": "Additional official Talos extensions embedded in the installation ISO (qemu-guest-agent is always included).",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extra_kernel_args": {
      "type": "array",
      "title": "Extra Kernel Arguments",
      "description": "Additional Linux kernel parameters (e.g. 'intel_iommu=on', 'iommu=pt').",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dns_servers": {
      "type": "array",
      "title": "Global DNS Servers",
      "items": {
        "type": "string"
      }
    },
    "dns_search_domains": {
      "type": "array",
      "title": "Global DNS Search Domains",
      "items": {
        "type": "string"
      }
    },
    "_section_system": {
      "type": "object",
      "title": "System and Firmware",
      "readOnly": true,
      "properties": {}
    },
    "machine_type": {
      "type": "string",
      "title": "Machine",
      "default": "q35",
      "description": "QEMU machine type ('q35' recommended for PCIe/GPU passthrough). Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "q35",
          "title": "q35"
        },
        {
          "const": "i440fx",
          "title": "i440fx"
        }
      ]
    },
    "bios": {
      "type": "string",
      "title": "BIOS / Firmware",
      "default": "seabios",
      "description": "VM firmware. 'ovmf' uses UEFI and is required for Secure Boot. Leave empty to use SeaBIOS. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "seabios",
          "title": "seabios"
        },
        {
          "const": "ovmf",
          "title": "ovmf"
        }
      ]
    },
    "secure_boot": {
      "type": "boolean",
      "title": "UEFI Secure Boot",
      "default": false,
      "description": "Verify the Talos bootloader and operating system at boot. Requires BIOS / Firmware = ovmf. New ISO VMs enroll Talos keys automatically. Clones inherit the template's firmware and keys. Existing VMs require reprovisioning to change this setting."
    },
    "tpm": {
      "type": "boolean",
      "title": "TPM 2.0",
      "default": false,
      "description": "Attach a virtual TPM 2.0 state device."
    },
    "scsihw": {
      "type": "string",
      "title": "SCSI Controller",
      "default": "virtio-scsi-single",
      "description": "SCSI controller model ('virtio-scsi-single' recommended for IOThread). Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "virtio-scsi-single",
          "title": "virtio-scsi-single"
        },
        {
          "const": "virtio-scsi-pci",
          "title": "virtio-scsi-pci"
        },
        {
          "const": "lsi",
          "title": "lsi"
        },
        {
          "const": "lsi53c810",
          "title": "lsi53c810"
        },
        {
          "const": "megasas",
          "title": "megasas"
        },
        {
          "const": "pvscsi",
          "title": "pvscsi"
        }
      ]
    },
    "vga": {
      "type": "string",
      "title": "Display (VGA)",
      "default": "std",
      "description": "Proxmox display adapter. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "std",
          "title": "std"
        },
        {
          "const": "virtio",
          "title": "virtio"
        },
        {
          "const": "virtio-gl",
          "title": "virtio-gl"
        },
        {
          "const": "qxl",
          "title": "qxl"
        },
        {
          "const": "serial0",
          "title": "serial0"
        },
        {
          "const": "none",
          "title": "none"
        },
        {
          "const": "cirrus",
          "title": "cirrus"
        },
        {
          "const": "vmware",
          "title": "vmware"
        }
      ]
    },
    "serial_console": {
      "type": "boolean",
      "title": "Serial Console (serial0)",
      "default": false,
      "description": "Attach a virtual serial socket for Proxmox xterm.js console."
    },
    "rng": {
      "type": "boolean",
      "title": "VirtIO RNG (/dev/urandom)",
      "default": true,
      "description": "Attach VirtIO hardware RNG for fast cryptographic entropy."
    },
    "watchdog_model": {
      "type": "string",
      "title": "Watchdog Model",
      "default": "",
      "description": "Optional virtual hardware watchdog device. Select the empty first row to clear this selection.",
