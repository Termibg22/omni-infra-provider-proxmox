          "enum": [
            "ACCEPT",
            "DROP",
            "REJECT"
          ]
        },
        "policy_out": {
          "type": "string",
          "title": "Outbound Policy",
          "default": "ACCEPT",
          "enum": [
            "ACCEPT",
            "DROP",
            "REJECT"
          ]
        },
        "dhcp": {
          "type": "boolean",
          "title": "Allow DHCP",
          "default": true
        },
        "macfilter": {
          "type": "boolean",
          "title": "MAC Filter",
          "default": true
        },
        "ipfilter": {
          "type": "boolean",
          "title": "IP Filter",
          "default": false
        },
        "ndp": {
          "type": "boolean",
          "title": "Allow IPv6 NDP",
          "default": true
        },
        "radv": {
          "type": "boolean",
          "title": "Allow Router Advertisements",
          "default": false
