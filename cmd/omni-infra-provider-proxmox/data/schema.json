        "max_relocate": {
          "type": [
            "integer",
            "null"
          ],
          "title": "Max Relocates",
          "default": 1,
          "allOf": [
            {
              "minimum": 0
            }
          ]
        },
        "failback": {
          "type": "boolean",
          "title": "Failback",
          "default": true
        },
        "resource_affinity": {
          "type": "string",
          "title": "Resource Affinity (PVE 9+)",
          "default": "none",
          "enum": [
            "none",
            "negative",
            "positive"
