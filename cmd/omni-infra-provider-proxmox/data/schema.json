                  "type": "string",
                  "title": "Destination (CIDR)"
                },
                "via": {
                  "type": "string",
                  "title": "Gateway (Via)"
                },
                "metric": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "title": "Metric",
                  "allOf": [
                    {
                      "minimum": 0
                    }
                  ]
                },
                "on_link": {
                  "type": "boolean",
                  "title": "On-Link",
                  "default": false
                }
              },
              "required": [
