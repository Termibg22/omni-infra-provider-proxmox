        "node_affinity_strict": {
          "type": "boolean",
          "title": "Strict Node Affinity",
          "default": false
        },
        "rules": {
          "type": "array",
          "title": "HA Rules (PVE 9+)",
          "items": {
            "type": "string"
          }
        },
        "comment": {
          "type": "string",
          "title": "Comment"
        }
      }
    },
