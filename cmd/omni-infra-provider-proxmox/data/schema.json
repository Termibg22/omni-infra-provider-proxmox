{
  "type": "object",
  "title": "Proxmox VM Configuration",
  "properties": {
    "general": {
      "type": "object",
      "title": "01. General",
      "description": "VM placement, node group, workload preset, resource pool, tags, and boot behavior.",
      "properties": {
        "workload_profile": {
          "type": "string",
          "title": "Workload Profile (Smart Preset)",
          "default": "standard",
          "enum": [
            "standard",
            "control-plane",
            "storage-node",
            "gpu-ai-worker",
            "hardened-secure"
          ],
          "description": "Smart preset that pre-configures optimal defaults and Talos extensions."
        },
        "node_group": {
          "type": "string",
          "title": "Node Group",
          "default": "auto",
          "description": "Logical node group (auto-discovered from HA Groups, HA Rules, SDN Zones, PCI Groups, or config.yaml). Use 'auto' for all cluster nodes."
        },
        "node": {
          "type": "string",
          "title": "Target Node",
          "default": "auto",
          "description": "Specific Proxmox node, or 'auto' to use the placement strategy."
        },
        "placement_strategy": {
          "type": "string",
          "title": "Placement Strategy",
          "default": "spread",
          "enum": [
            "spread",
            "fewer-vms",
            "round-robin",
            "binpack"
          ],
          "description": "Auto-placement strategy when Target Node is 'auto'."
        },
        "pool": {
          "type": "string",
          "title": "Resource Pool",
          "default": "auto",
          "description": "Proxmox resource pool, or 'auto' to use the Omni MachineRequestSet ID."
        },
        "auto_create_pool": {
          "type": "boolean",
          "title": "Auto-Create Resource Pool",
          "default": true,
          "description": "Automatically create the specified Proxmox resource pool if it does not exist."
        },
        "tags": {
          "type": "array",
          "title": "VM Tags",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Proxmox VM tags"
        },
        "description": {
          "type": "string",
          "title": "Notes / Description",
          "description": "Optional notes shown in the Proxmox VM Summary."
        },
        "onboot": {
          "type": "boolean",
          "title": "Start at Boot",
          "default": true,
          "description": "Automatically start the VM when the Proxmox host boots."
        },
        "protection": {
          "type": "boolean",
          "title": "Protection",
          "default": false,
          "description": "Prevent accidental manual VM deletion in Proxmox."
        },
        "min_vmid": {
          "type": ["integer", "null"],
          "title": "Minimum VMID",
          "minimum": 100,
          "maximum": 999999999,
          "description": "Optional lower bound for Proxmox VMID allocation (e.g. 5000)."
        },
        "max_vmid": {
          "type": ["integer", "null"],
          "title": "Maximum VMID",
          "minimum": 100,
          "maximum": 999999999,
          "description": "Optional upper bound for Proxmox VMID allocation (e.g. 5999)."
        }
      }
    },
    "os": {
      "type": "object",
      "title": "02. OS & Provisioning",
      "description": "Talos ISO / VM Template source, CPU architecture, system extensions, and kernel arguments.",
      "properties": {
        "provisioning_mode": {
          "type": "string",
          "title": "Provisioning Mode",
          "default": "iso",
          "enum": [
            "iso",
            "clone"
          ],
          "description": "'iso' boots from a Talos Image Factory ISO; 'clone' clones an existing Proxmox VM Template."
        },
        "iso_storage": {
          "type": "string",
          "title": "ISO Storage",
          "default": "auto",
          "description": "ISO-capable storage for Talos ISO and Cloud-Init images ('auto' picks the first available ISO storage)."
        },
        "template_vmid": {
          "type": "string",
          "title": "VM Template (Clone Mode)",
          "default": "none",
          "description": "Proxmox VM Template to clone when Provisioning Mode is 'clone' ('none' if using ISO mode)."
        },
        "full_clone": {
          "type": "boolean",
          "title": "Full Clone",
          "default": true,
          "description": "Perform a full disk clone (true) or linked clone (false) in clone mode."
        },
        "architecture": {
          "type": "string",
          "title": "Architecture",
          "default": "amd64",
          "enum": [
            "amd64",
            "arm64"
          ],
          "description": "Target CPU architecture for the Talos installation media."
        },
        "talos_extensions": {
          "type": "array",
          "title": "Talos System Extensions",
          "description": "Additional official Talos extensions embedded in the installation ISO (qemu-guest-agent is always included).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extra_kernel_args": {
          "type": "array",
          "title": "Extra Kernel Arguments",
          "description": "Additional Linux kernel parameters (e.g. 'intel_iommu=on', 'iommu=pt').",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "system": {
      "type": "object",
      "title": "03. System & Hardware",
      "description": "Proxmox VM machine type, UEFI/BIOS firmware, TPM, SCSI controller, display, and watchdog.",
      "properties": {
        "machine_type": {
          "type": "string",
          "title": "Machine",
          "default": "q35",
          "enum": [
            "q35",
            "i440fx"
          ],
          "description": "QEMU machine type ('q35' recommended for PCIe/GPU passthrough)."
        },
        "bios": {
          "type": "string",
          "title": "BIOS / Firmware",
          "default": "seabios",
          "enum": [
            "seabios",
            "ovmf"
          ],
          "description": "VM firmware ('ovmf' enables UEFI, EFI disk, and Secure Boot)."
        },
        "secure_boot": {
          "type": "boolean",
          "title": "UEFI Secure Boot",
          "default": false,
          "description": "Enable UEFI Secure Boot (requires BIOS='ovmf')."
        },
        "tpm": {
          "type": "boolean",
          "title": "TPM 2.0",
          "default": false,
          "description": "Attach a virtual TPM 2.0 state device."
        },
        "scsihw": {
          "type": "string",
          "title": "SCSI Controller",
          "default": "virtio-scsi-single",
          "enum": [
            "virtio-scsi-single",
            "virtio-scsi-pci",
            "lsi",
            "lsi53c810",
            "megasas",
            "pvscsi"
          ],
          "description": "SCSI controller model ('virtio-scsi-single' recommended for IOThread)."
        },
        "vga": {
          "type": "string",
          "title": "Display (VGA)",
          "default": "std",
          "enum": [
            "std",
            "virtio",
            "virtio-gl",
            "qxl",
            "serial0",
            "none",
            "cirrus",
            "vmware"
          ],
          "description": "Proxmox display adapter."
        },
        "serial_console": {
          "type": "boolean",
          "title": "Serial Console (serial0)",
          "default": false,
          "description": "Attach a virtual serial socket for Proxmox xterm.js console."
        },
        "rng": {
          "type": "boolean",
          "title": "VirtIO RNG (/dev/urandom)",
          "default": true,
          "description": "Attach VirtIO hardware RNG for fast cryptographic entropy."
        },
        "watchdog_model": {
          "type": "string",
          "title": "Watchdog Model",
          "default": "none",
          "enum": [
            "none",
            "i6300esb",
            "ib700"
          ],
          "description": "Optional virtual hardware watchdog device."
        },
        "watchdog_action": {
          "type": "string",
          "title": "Watchdog Action",
          "default": "reset",
          "enum": [
            "reset",
            "poweroff",
            "pause",
            "debug",
            "none"
          ],
          "description": "Action when the watchdog timer expires."
        },
        "startup_order": {
          "type": "string",
          "title": "Start/Shutdown Order",
          "description": "Proxmox startup order (e.g. 'order=1,up=30,down=60')."
        }
      }
    },
    "compute": {
      "type": "object",
      "title": "04. CPU & Memory",
      "description": "CPU cores, sockets, model, memory allocation, ballooning, NUMA, and hugepages.",
      "properties": {
        "cores": {
          "type": "integer",
          "title": "Cores",
          "default": 2,
          "minimum": 1,
          "description": "Number of CPU cores per socket"
        },
        "sockets": {
          "type": "integer",
          "title": "Sockets",
          "default": 1,
          "minimum": 1,
          "description": "Number of CPU sockets"
        },
        "cpu_type": {
          "type": "string",
          "title": "CPU Type",
          "default": "x86-64-v2-AES",
          "enum": [
            "x86-64-v2-AES",
            "x86-64-v3",
            "x86-64-v4",
            "host",
            "max",
            "kvm64",
            "qemu64"
          ],
          "description": "QEMU CPU model ('host' for max performance/GPU, 'x86-64-v2-AES' for live migration)."
        },
        "memory": {
          "type": "integer",
          "title": "Memory (MB)",
          "default": 4096,
          "minimum": 2048,
          "description": "RAM allocation in MiB"
        },
        "balloon": {
          "type": "boolean",
          "title": "Ballooning Device",
          "default": true,
          "description": "Enable memory ballooning (disable for GPU passthrough or hugepages)."
        },
        "numa": {
          "type": "boolean",
          "title": "Enable NUMA",
          "default": false,
          "description": "Enable NUMA topology."
        },
        "hugepages": {
          "type": "string",
          "title": "Hugepages",
          "default": "none",
          "enum": [
            "none",
            "any",
            "2MB",
            "1GB"
          ],
          "description": "Hugepages size ('none' to disable)."
        },
        "cpu_flags": {
          "type": "string",
          "title": "CPU Flags",
          "description": "Optional semicolon-separated CPU flags (e.g. '+aes;+avx2;+pdpe1gb')."
        },
        "cpu_limit": {
          "type": ["number", "null"],
          "title": "CPU Limit",
          "minimum": 0,
          "description": "Optional max CPU cores limit (null or 0 for unlimited)."
        },
        "cpu_units": {
          "type": ["integer", "null"],
          "title": "CPU Units",
          "minimum": 1,
          "maximum": 262144,
          "description": "Optional relative CPU scheduler weight."
        }
      },
      "required": [
        "cores",
        "memory"
      ]
    },
    "disks": {
      "type": "array",
      "title": "05. Disks (Boot Disk & Data Disks)",
      "description": "Unified VM disk list. Entry #1 is the boot disk (scsi0); additional entries are data disks (scsi1, scsi2, ...). Supports live add, remove, and online resize.",
      "items": {
        "type": "object",
        "title": "Hard Disk",
        "properties": {
          "storage": {
            "type": "string",
            "title": "Storage",
            "default": "auto",
            "description": "VM-disk-capable Proxmox storage pool ('auto' picks the first available)."
          },
          "size": {
            "type": "integer",
            "title": "Disk Size (GB)",
            "default": 20,
            "minimum": 1,
            "description": "Disk size in GB"
          },
          "bus": {
            "type": "string",
            "title": "Bus / Device",
            "default": "scsi",
            "enum": [
              "scsi",
              "virtio",
              "sata"
            ],
            "description": "Disk controller bus"
          },
          "cache": {
            "type": "string",
            "title": "Cache",
            "default": "none",
            "enum": [
              "none",
              "writethrough",
              "writeback",
              "directsync",
              "unsafe"
            ],
            "description": "Disk cache mode"
          },
          "aio": {
            "type": "string",
            "title": "Async IO",
            "default": "io_uring",
            "enum": [
              "io_uring",
              "native",
              "threads"
            ],
            "description": "Async IO mode"
          },
          "ssd": {
            "type": "boolean",
            "title": "SSD Emulation",
            "default": true,
            "description": "Enable SSD emulation (ssd=1)"
          },
          "discard": {
            "type": "boolean",
            "title": "Discard (TRIM)",
            "default": true,
            "description": "Enable TRIM/discard"
          },
          "iothread": {
            "type": "boolean",
            "title": "IO Thread",
            "default": true,
            "description": "Enable dedicated IO thread"
          },
          "backup": {
            "type": "boolean",
            "title": "Backup",
            "default": true,
            "description": "Include disk in Proxmox backups"
          },
          "replicate": {
            "type": "boolean",
            "title": "Skip Replication",
            "default": false,
            "description": "Include disk in Proxmox storage replication"
          },
          "volume_name": {
            "type": "string",
            "title": "Talos Volume Name (Auto-Mount)",
            "description": "Optional name for data disks: auto-generates a Talos UserVolumeConfig mounted at /var/mnt/<volume_name>."
          },
          "iops_read": {
            "type": ["integer", "null"],
            "title": "Read Limit (IOPS)",
            "minimum": 0
          },
          "iops_write": {
            "type": ["integer", "null"],
            "title": "Write Limit (IOPS)",
            "minimum": 0
          },
          "mbps_read": {
            "type": ["number", "null"],
            "title": "Read Limit (MB/s)",
            "minimum": 0
          },
          "mbps_write": {
            "type": ["number", "null"],
            "title": "Write Limit (MB/s)",
            "minimum": 0
          }
        },
        "required": [
          "size"
        ]
      }
    },
    "network": {
      "type": "object",
      "title": "06. Network",
      "description": "VM network interfaces (net0, net1, ...), LACP bonds, static IPs / IP pools, and global DNS.",
      "properties": {
        "nics": {
          "type": "array",
          "title": "Network Devices (NICs)",
          "description": "List of VM network cards (net0, net1, ...).",
          "items": {
            "type": "object",
            "title": "Network Device",
            "properties": {
              "bridge": {
                "type": "string",
                "title": "Bridge / SDN VNet",
                "default": "vmbr0",
                "description": "Proxmox bridge or SDN VNet"
              },
              "model": {
                "type": "string",
                "title": "Model",
                "default": "virtio",
                "enum": [
                  "virtio",
                  "e1000",
                  "e1000e",
                  "vmxnet3",
                  "rtl8139"
                ]
              },
              "vlan": {
                "type": ["integer", "null"],
                "title": "VLAN Tag",
                "default": 0,
                "minimum": 0,
                "maximum": 4094
              },
              "firewall": {
                "type": "boolean",
                "title": "Firewall",
                "default": true
              },
              "mtu": {
                "type": ["integer", "null"],
                "title": "MTU",
                "minimum": 1,
                "maximum": 65520
              },
              "queues": {
                "type": ["integer", "null"],
                "title": "Multiqueue",
                "minimum": 1,
                "maximum": 64
              },
              "rate_limit": {
                "type": ["number", "null"],
                "title": "Rate Limit (MB/s)",
                "minimum": 0
              },
              "mac_address": {
                "type": "string",
                "title": "MAC Address"
              },
              "trunks": {
                "type": "string",
                "title": "VLAN Trunks"
              },
              "dhcp4": {
                "type": "boolean",
                "title": "DHCPv4",
                "default": true
              },
              "dhcp6": {
                "type": "boolean",
                "title": "DHCPv6",
                "default": false
              },
              "ip_pool": {
                "type": "string",
                "title": "Static IP Pool (Auto-Assign)",
                "description": "CIDR range (e.g. '192.168.1.100-192.168.1.150/24') to auto-assign unique IPs per VM."
              },
              "addresses": {
                "type": "array",
                "title": "Static IP Addresses (CIDR)",
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "gateway4": {
                "type": "string",
                "title": "IPv4 Gateway"
              },
              "gateway6": {
                "type": "string",
                "title": "IPv6 Gateway"
              },
              "nameservers": {
                "type": "array",
                "title": "DNS Servers",
                "items": {
                  "type": "string"
                }
              },
              "search_domains": {
                "type": "array",
                "title": "DNS Search Domains",
                "items": {
                  "type": "string"
                }
              },
              "routes": {
                "type": "array",
                "title": "Static Routes",
                "items": {
                  "type": "object",
                  "title": "Route",
                  "properties": {
                    "to": {
                      "type": "string",
                      "title": "Destination (CIDR)"
                    },
                    "via": {
                      "type": "string",
                      "title": "Gateway (Via)"
                    },
                    "metric": {
                      "type": ["integer", "null"],
                      "title": "Metric",
                      "minimum": 0
                    },
                    "on_link": {
                      "type": "boolean",
                      "title": "On-Link",
                      "default": false
                    }
                  },
                  "required": [
                    "to",
                    "via"
                  ]
                }
              }
            },
            "required": [
              "bridge"
            ]
          }
        },
        "bonds": {
          "type": "array",
          "title": "Network Bonds (LACP / Active-Backup)",
          "items": {
            "type": "object",
            "title": "Bond",
            "properties": {
              "name": {
                "type": "string",
                "title": "Bond Name",
                "default": "bond0"
              },
              "interfaces": {
                "type": "array",
                "title": "Member Interfaces",
                "items": {
                  "type": "string"
                }
              },
              "mode": {
                "type": "string",
                "title": "Mode",
                "default": "802.3ad",
                "enum": [
                  "802.3ad",
                  "active-backup",
                  "balance-xor",
                  "broadcast",
                  "balance-tlb",
                  "balance-alb"
                ]
              },
              "lacp_rate": {
                "type": "string",
                "title": "LACP Rate",
                "default": "fast",
                "enum": [
                  "fast",
                  "slow"
                ]
              },
              "transmit_hash_policy": {
                "type": "string",
                "title": "Hash Policy",
                "default": "layer2+3",
                "enum": [
                  "layer2",
                  "layer2+3",
                  "layer3+4"
                ]
              },
              "mii_monitor_interval": {
                "type": ["integer", "null"],
                "title": "MII Monitor (ms)",
                "default": 100,
                "minimum": 0
              },
              "mtu": {
                "type": ["integer", "null"],
                "title": "MTU",
                "minimum": 576,
                "maximum": 65520
              },
              "dhcp4": {
                "type": "boolean",
                "title": "DHCPv4",
                "default": true
              },
              "ip_pool": {
                "type": "string",
                "title": "Static IP Pool"
              },
              "addresses": {
                "type": "array",
                "title": "Static IP Addresses (CIDR)",
                "items": {
                  "type": "string"
                }
              },
              "gateway4": {
                "type": "string",
                "title": "IPv4 Gateway"
              }
            },
            "required": [
              "name",
              "interfaces"
            ]
          }
        },
        "dns_servers": {
          "type": "array",
          "title": "Global DNS Servers",
          "items": {
            "type": "string"
          }
        },
        "dns_search_domains": {
          "type": "array",
          "title": "Global DNS Search Domains",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ha": {
      "type": "object",
      "title": "07. High Availability (Proxmox HA)",
      "description": "Register VMs in Proxmox HA (leave State as 'none' to disable HA).",
      "properties": {
        "state": {
          "type": "string",
          "title": "HA State",
          "default": "none",
          "enum": [
            "none",
            "started",
            "stopped",
            "disabled",
            "ignored"
          ]
        },
        "group": {
          "type": "string",
          "title": "HA Group",
          "default": "none"
        },
        "max_restart": {
          "type": ["integer", "null"],
          "title": "Max Restarts",
          "default": 1,
          "minimum": 0
        },
        "max_relocate": {
          "type": ["integer", "null"],
          "title": "Max Relocates",
          "default": 1,
          "minimum": 0
        },
        "failback": {
          "type": "boolean",
          "title": "Failback",
          "default": true
        },
        "resource_affinity": {
          "type": "string",
          "title": "Resource Affinity (PVE 9+)",
          "default": "none",
          "enum": [
            "none",
            "negative",
            "positive"
          ]
        },
        "node_affinity_nodes": {
          "type": "array",
          "title": "Node Affinity Nodes (PVE 9+)",
          "items": {
            "type": "string"
          }
        },
        "node_affinity_strict": {
          "type": "boolean",
          "title": "Strict Node Affinity",
          "default": false
        },
        "rules": {
          "type": "array",
          "title": "HA Rules (PVE 9+)",
          "items": {
            "type": "string"
          }
        },
        "comment": {
          "type": "string",
          "title": "Comment"
        }
      }
    },
    "replication": {
      "type": "object",
      "title": "08. Storage Replication (ZFS)",
      "description": "Automatic ZFS storage replication across cluster nodes.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable Replication",
          "default": false
        },
        "schedule": {
          "type": "string",
          "title": "Schedule",
          "default": "*/15"
        },
        "target_node": {
          "type": "string",
          "title": "Target Node",
          "default": "auto"
        },
        "rate_limit": {
          "type": ["number", "null"],
          "title": "Rate Limit (MB/s)",
          "minimum": 0
        }
      }
    },
    "firewall": {
      "type": "object",
      "title": "09. Firewall & Security",
      "description": "Proxmox cluster security groups and VM-level firewall policy.",
      "properties": {
        "security_groups": {
          "type": "array",
          "title": "Security Groups",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "object",
          "title": "VM Firewall Options",
          "properties": {
            "enable": {
              "type": "boolean",
              "title": "Enable Firewall",
              "default": false
            },
            "policy_in": {
              "type": "string",
              "title": "Inbound Policy",
              "default": "ACCEPT",
              "enum": [
                "ACCEPT",
                "DROP",
                "REJECT"
              ]
            },
            "policy_out": {
              "type": "string",
              "title": "Outbound Policy",
              "default": "ACCEPT",
              "enum": [
                "ACCEPT",
                "DROP",
                "REJECT"
              ]
            },
            "dhcp": {
              "type": "boolean",
              "title": "Allow DHCP",
              "default": true
            },
            "macfilter": {
              "type": "boolean",
              "title": "MAC Filter",
              "default": true
            },
            "ipfilter": {
              "type": "boolean",
              "title": "IP Filter",
              "default": false
            },
            "ndp": {
              "type": "boolean",
              "title": "Allow IPv6 NDP",
              "default": true
            },
            "radv": {
              "type": "boolean",
              "title": "Allow Router Advertisements",
              "default": false
            }
          }
        }
      }
    },
    "passthrough": {
      "type": "object",
