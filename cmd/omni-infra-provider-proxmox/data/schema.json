{
  "type": "object",
  "title": "Proxmox VM Configuration",
  "properties": {
    "node_group": {
      "type": "string",
      "title": "Node Group",
      "default": "",
      "description": "Limit placement to a group of Proxmox nodes. Leave empty to use all current nodes. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "node": {
      "type": "string",
      "title": "Target Node",
      "default": "",
      "description": "Pin this VM to a Proxmox node. Leave empty to use the placement strategy. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "pool": {
      "type": "string",
      "title": "Resource Pool",
      "default": "",
      "description": "Proxmox resource pool. Leave empty to use the Omni MachineRequestSet ID. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "cores": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Cores (default: 2)",
      "default": 2,
      "description": "CPU cores per socket. Omitted, blank or 0 uses 2. Existing saved values are shown directly.",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1
            }
          ]
        }
      ]
    },
    "memory": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Memory (MiB, default: 4096)",
      "default": 4096,
      "description": "RAM in MiB. Omitted, blank or 0 uses 4096. Existing saved values are shown directly.",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 2048
            }
          ]
        }
      ]
    },
    "_section_boot_disk": {
      "type": "object",
      "title": "Boot Disk",
      "readOnly": true,
      "properties": {}
    },
    "disk_size": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Primary boot disk size in GiB. Empty or 0 uses 20. The All Disks list, when populated, replaces this boot disk.",
      "title": "Size (GiB, default: 20)",
      "default": 20,
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 5
            }
          ]
        }
      ]
    },
    "storage": {
      "type": "string",
      "title": "Storage",
      "default": "",
      "description": "Destination for the boot disk. Leave empty to use the storage selector below, or choose an available VM disk storage automatically. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "storage_selector": {
      "type": "string",
      "description": "Optional CEL expression or storage name used when Storage is empty. For example: name == \"local-zfs\".",
      "title": "Storage Selector (CEL)"
    },
    "disk_ssd": {
      "type": "boolean",
      "description": "Enable SSD emulation (ssd=1) for better performance on SSD/NVMe storage",
      "title": "SSD Emulation"
    },
    "disk_discard": {
      "type": "boolean",
      "description": "Enable TRIM/discard support for thin-provisioned storage",
      "title": "Discard (TRIM)"
    },
    "disk_iothread": {
      "type": "boolean",
      "description": "Enable dedicated IO thread for better disk performance",
      "title": "IO Thread"
    },
    "disk_cache": {
      "type": "string",
      "description": "Disk cache mode. Leave empty to use Proxmox's default. Select the empty first row to clear this selection.",
      "title": "Cache",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "none",
          "title": "none"
        },
        {
          "const": "writethrough",
          "title": "writethrough"
        },
        {
          "const": "writeback",
          "title": "writeback"
        },
        {
          "const": "directsync",
          "title": "directsync"
        },
        {
          "const": "unsafe",
          "title": "unsafe"
        }
      ]
    },
    "disk_aio": {
      "type": "string",
      "description": "Async IO mode. Leave empty to use Proxmox's default. Select the empty first row to clear this selection.",
      "title": "Async IO",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "native",
          "title": "native"
        },
        {
          "const": "threads",
          "title": "threads"
        },
        {
          "const": "io_uring",
          "title": "io_uring"
        }
      ]
    },
    "_section_primary_nic": {
      "type": "object",
      "title": "Primary NIC",
      "readOnly": true,
      "properties": {}
    },
    "network_bridge": {
      "type": "string",
      "description": "Bridge for the primary VirtIO NIC. Leave empty to use vmbr0. Select the empty first row to clear this selection.",
      "title": "Bridge",
      "default": "",
      "oneOf": [
        {
          "const": "",
          "title": " "
        }
      ]
    },
    "vlan": {
      "type": [
        "integer",
        "null"
      ],
      "description": "VLAN tag for primary NIC, set to 0 for none",
      "title": "VLAN Tag",
      "allOf": [
        {
          "minimum": 0
        }
      ]
    },
    "network_firewall": {
      "type": "boolean",
      "description": "Enable per-VM firewall (fwbr) on primary NIC. Defaults to true. Set false when L2-broadcast services need traffic to bypass fwbr.",
      "title": "Firewall"
    },
    "_section_extra_devices": {
      "type": "object",
      "title": "Additional Devices and Overrides",
      "readOnly": true,
      "properties": {}
    },
    "additional_disks": {
      "type": "array",
      "description": "Extra data disks appended after the boot disk. Leave empty for a single disk.",
      "items": {
        "type": "object",
        "properties": {
          "disk_size": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Disk size in GB",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1
                  }
                ]
              }
            ]
          },
          "storage_selector": {
            "type": "string",
            "description": "Optional CEL expression. Used when Storage is empty; if both are empty, inherit the boot disk storage selection."
          },
          "disk_ssd": {
            "type": "boolean",
            "description": "Enable SSD emulation for this disk"
          },
          "disk_discard": {
            "type": "boolean",
            "description": "Enable TRIM/discard support for this disk"
          },
          "disk_iothread": {
            "type": "boolean",
            "description": "Enable dedicated IO thread for this disk"
          },
          "disk_cache": {
            "type": "string",
            "description": "Disk cache mode for this disk. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "none",
                "title": "none"
              },
              {
                "const": "writethrough",
                "title": "writethrough"
              },
              {
                "const": "writeback",
                "title": "writeback"
              },
              {
                "const": "directsync",
                "title": "directsync"
              },
              {
                "const": "unsafe",
                "title": "unsafe"
              }
            ]
          },
          "disk_aio": {
            "type": "string",
            "description": "Async IO mode for this disk. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "native",
                "title": "native"
              },
              {
                "const": "threads",
                "title": "threads"
              },
              {
                "const": "io_uring",
                "title": "io_uring"
              }
            ]
          },
          "storage": {
            "type": "string",
            "title": "Storage",
            "default": "",
            "description": "VM-disk-capable Proxmox storage pool (empty selects an available VM disk storage). Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              }
            ]
          }
        },
        "required": [
          "disk_size"
        ]
      },
      "title": "Additional Disks"
    },
    "additional_nics": {
      "type": "array",
      "description": "Extra network adapters appended after the primary NIC. Leave empty for one adapter.",
      "items": {
        "type": "object",
        "properties": {
          "bridge": {
            "type": "string",
            "description": "Network bridge (e.g., vmbr1)"
          },
          "vlan": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Optional VLAN tag",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "firewall": {
            "type": "boolean",
            "description": "Enable Proxmox firewall for this NIC"
          },
          "addresses": {
            "type": "array",
            "title": "Static IP Addresses (CIDR)",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "gateway4": {
            "type": "string",
            "title": "IPv4 Gateway"
          },
          "ip_pool": {
            "type": "string",
            "title": "Static IP Pool (Auto-Assign)",
            "description": "CIDR range (e.g. '192.168.1.100-192.168.1.150/24') to auto-assign unique IPs per VM."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "virtio",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "virtio",
                "title": "virtio"
              },
              {
                "const": "e1000",
                "title": "e1000"
              },
              {
                "const": "e1000e",
                "title": "e1000e"
              },
              {
                "const": "vmxnet3",
                "title": "vmxnet3"
              },
              {
                "const": "rtl8139",
                "title": "rtl8139"
              }
            ],
            "description": "Select the empty first row to clear this selection."
          },
          "mtu": {
            "type": [
              "integer",
              "null"
            ],
            "title": "MTU",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1,
                    "maximum": 65520
                  }
                ]
              }
            ]
          },
          "queues": {
            "type": [
              "integer",
              "null"
            ],
            "title": "Multiqueue",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1,
                    "maximum": 64
                  }
                ]
              }
            ]
          },
          "rate_limit": {
            "type": [
              "number",
              "null"
            ],
            "title": "Rate Limit (MB/s)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          }
        },
        "required": [
          "bridge"
        ]
      },
      "title": "Additional NICs"
    },
    "disks": {
      "type": "array",
      "title": "All Disks (override boot disk)",
      "description": "Optional complete disk configuration for per-disk bus, QoS and Talos volume settings. The FIRST entry replaces the boot disk above. Extra entries are data disks. Additional Disks are appended afterwards.",
      "items": {
        "type": "object",
        "title": "Hard Disk",
        "properties": {
          "storage": {
            "type": "string",
            "title": "Storage",
            "default": "",
            "description": "VM-disk-capable Proxmox storage pool (empty selects an available VM disk storage). Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              }
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "title": "Disk Size (GB)",
            "default": 20,
            "description": "Disk size in GB",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1
                  }
                ]
              }
            ]
          },
          "bus": {
            "type": "string",
            "title": "Bus / Device",
            "default": "scsi",
            "description": "Disk controller bus. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "scsi",
                "title": "scsi"
              },
              {
                "const": "virtio",
                "title": "virtio"
              },
              {
                "const": "sata",
                "title": "sata"
              }
            ]
          },
          "cache": {
            "type": "string",
            "title": "Cache",
            "default": "none",
            "description": "Disk cache mode. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "none",
                "title": "none"
              },
              {
                "const": "writethrough",
                "title": "writethrough"
              },
              {
                "const": "writeback",
                "title": "writeback"
              },
              {
                "const": "directsync",
                "title": "directsync"
              },
              {
                "const": "unsafe",
                "title": "unsafe"
              }
            ]
          },
          "aio": {
            "type": "string",
            "title": "Async IO",
            "default": "io_uring",
            "description": "Async IO mode. Select the empty first row to clear this selection.",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "io_uring",
                "title": "io_uring"
              },
              {
                "const": "native",
                "title": "native"
              },
              {
                "const": "threads",
                "title": "threads"
              }
            ]
          },
          "ssd": {
            "type": "boolean",
            "title": "SSD Emulation",
            "default": true,
            "description": "Enable SSD emulation (ssd=1)"
          },
          "discard": {
            "type": "boolean",
            "title": "Discard (TRIM)",
            "default": true,
            "description": "Enable TRIM/discard"
          },
          "iothread": {
            "type": "boolean",
            "title": "IO Thread",
            "default": true,
            "description": "Enable dedicated IO thread"
          },
          "backup": {
            "type": "boolean",
            "title": "Backup",
            "default": true,
            "description": "Include disk in Proxmox backups"
          },
          "replicate": {
            "type": "boolean",
            "title": "Include in Replication",
            "default": true,
            "description": "Include disk in Proxmox storage replication"
          },
          "volume_name": {
            "type": "string",
            "title": "Talos Volume Name (Auto-Mount)",
            "description": "Optional name for data disks: auto-generates a Talos UserVolumeConfig mounted at /var/mnt/<volume_name>."
          },
          "iops_read": {
            "type": [
              "integer",
              "null"
            ],
            "title": "Read Limit (IOPS)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "iops_write": {
            "type": [
              "integer",
              "null"
            ],
            "title": "Write Limit (IOPS)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "mbps_read": {
            "type": [
              "number",
              "null"
            ],
            "title": "Read Limit (MB/s)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "mbps_write": {
            "type": [
              "number",
              "null"
            ],
            "title": "Write Limit (MB/s)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "storage_selector": {
            "type": "string",
            "title": "Storage Selector (CEL)",
            "description": "Preserves an existing CEL storage selection. Used only when Storage is empty."
          }
        },
        "required": [
          "size"
        ]
      }
    },
    "nics": {
      "type": "array",
      "title": "All NICs (override primary NIC)",
      "description": "Optional complete NIC configuration for addresses, routing, MTU and queues. The FIRST entry replaces the primary NIC above. Additional NICs are appended afterwards.",
      "items": {
        "type": "object",
        "title": "Network Device",
        "properties": {
          "bridge": {
            "type": "string",
            "title": "Bridge / SDN VNet",
            "default": "vmbr0",
            "description": "Proxmox bridge or SDN VNet"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "virtio",
            "oneOf": [
              {
                "const": "",
                "title": " "
              },
              {
                "const": "virtio",
                "title": "virtio"
              },
              {
                "const": "e1000",
                "title": "e1000"
              },
              {
                "const": "e1000e",
                "title": "e1000e"
              },
              {
                "const": "vmxnet3",
                "title": "vmxnet3"
              },
              {
                "const": "rtl8139",
                "title": "rtl8139"
              }
            ],
            "description": "Select the empty first row to clear this selection."
          },
          "vlan": {
            "type": [
              "integer",
              "null"
            ],
            "title": "VLAN Tag",
            "default": 0,
            "allOf": [
              {
                "minimum": 0,
                "maximum": 4094
              }
            ]
          },
          "firewall": {
            "type": "boolean",
            "title": "Firewall",
            "default": true
          },
          "mtu": {
            "type": [
              "integer",
              "null"
            ],
            "title": "MTU",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1,
                    "maximum": 65520
                  }
                ]
              }
            ]
          },
          "queues": {
            "type": [
              "integer",
              "null"
            ],
            "title": "Multiqueue",
            "allOf": [
              {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1,
                    "maximum": 64
                  }
                ]
              }
            ]
          },
          "rate_limit": {
            "type": [
              "number",
              "null"
            ],
            "title": "Rate Limit (MB/s)",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "mac_address": {
            "type": "string",
            "title": "MAC Address"
          },
          "trunks": {
            "type": "string",
            "title": "VLAN Trunks"
          },
          "dhcp4": {
            "type": "boolean",
            "title": "DHCPv4"
          },
          "dhcp6": {
            "type": "boolean",
            "title": "DHCPv6",
            "default": false
          },
          "ip_pool": {
            "type": "string",
            "title": "Static IP Pool (Auto-Assign)",
            "description": "CIDR range (e.g. '192.168.1.100-192.168.1.150/24') to auto-assign unique IPs per VM."
          },
          "addresses": {
            "type": "array",
            "title": "Static IP Addresses (CIDR)",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "gateway4": {
            "type": "string",
            "title": "IPv4 Gateway"
          },
          "gateway6": {
            "type": "string",
            "title": "IPv6 Gateway"
          },
          "nameservers": {
            "type": "array",
            "title": "DNS Servers",
            "items": {
              "type": "string"
            }
          },
          "search_domains": {
            "type": "array",
            "title": "DNS Search Domains",
            "items": {
              "type": "string"
            }
          },
          "routes": {
            "type": "array",
            "title": "Static Routes",
            "items": {
              "type": "object",
              "title": "Route",
              "properties": {
                "to": {
                  "type": "string",
                  "title": "Destination (CIDR)"
                },
                "via": {
                  "type": "string",
                  "title": "Gateway (Via)"
                },
                "metric": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "title": "Metric",
                  "allOf": [
                    {
                      "minimum": 0
                    }
                  ]
                },
                "on_link": {
                  "type": "boolean",
                  "title": "On-Link",
                  "default": false
                }
              },
              "required": [
                "to",
                "via"
              ]
            }
          }
        },
        "required": [
          "bridge"
        ]
      }
    },
    "_section_compute": {
      "type": "object",
      "title": "Advanced CPU and Memory",
      "readOnly": true,
      "properties": {}
    },
    "sockets": {
      "type": [
        "integer",
        "null"
      ],
      "title": "Sockets",
      "default": 1,
      "description": "Number of CPU sockets",
      "allOf": [
        {
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1
            }
          ]
        }
      ]
    },
    "cpu_type": {
      "type": "string",
      "title": "CPU Type",
      "default": "x86-64-v2-AES",
      "description": "QEMU CPU model ('host' for max performance/GPU, 'x86-64-v2-AES' for live migration). Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "x86-64-v2-AES",
          "title": "x86-64-v2-AES"
        },
        {
          "const": "x86-64-v3",
          "title": "x86-64-v3"
        },
        {
          "const": "x86-64-v4",
          "title": "x86-64-v4"
        },
        {
          "const": "host",
          "title": "host"
        },
        {
          "const": "max",
          "title": "max"
        },
        {
          "const": "kvm64",
          "title": "kvm64"
        },
        {
          "const": "qemu64",
          "title": "qemu64"
        }
      ]
    },
    "balloon": {
      "type": "boolean",
      "title": "Ballooning Device",
      "default": true,
      "description": "Enable memory ballooning (disable for GPU passthrough or hugepages)."
    },
    "numa": {
      "type": "boolean",
      "title": "Enable NUMA",
      "default": false,
      "description": "Enable NUMA topology."
    },
    "hugepages": {
      "type": "string",
      "title": "Hugepages",
      "default": "",
      "description": "Hugepage size. Leave empty to use normal memory pages. Select the empty first row to clear this selection.",
      "oneOf": [
        {
          "const": "",
          "title": " "
        },
        {
          "const": "any",
          "title": "any"
        },
        {
          "const": "2MB",
          "title": "2MB"
        },
        {
          "const": "1GB",
          "title": "1GB"
        }
      ]
    },
    "cpu_flags": {
      "type": "string",
      "title": "CPU Flags",
      "description": "Optional semicolon-separated CPU flags (e.g. '+aes;+avx2;+pdpe1gb')."
    },
    "cpu_limit": {
      "type": [
        "number",
        "null"
      ],
      "title": "CPU Limit",
      "description": "Optional max CPU cores limit (null or 0 for unlimited).",
      "allOf": [
        {
          "minimum": 0
        }
